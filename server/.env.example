# deploy/setup-vps.sh bu dosyayı otomatik olarak server/.env adıyla oluşturur.
# Elle kurulum yapıyorsanız bu şablonu kopyalayıp doldurun: cp .env.example .env

ADMIN_USERNAME=admin
# Şifre hash'i üretmek için (server/ klasöründe, npm install sonrası):
#   node -e "console.log(require('bcryptjs').hashSync('sifreniz', 10))"
ADMIN_PASSWORD_HASH=
# Rastgele üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Node uygulamasının dinleyeceği dahili port (nginx bu porta proxy_pass yapar)
ADMIN_PORT=4001
# Panelde "Siteyi Görüntüle" linkinin gideceği adres
SITE_URL=http://YOUR_VPS_IP:8081/
